---
import Container from './Container.astro';
import { site } from '../config/site';
const { email, github, linkedIn } = site.contact;
---
<footer class="site-footer">
  <Container class="footer-inner">
    <div>
      <a class="wordmark" href="/"><span class="brand-mark" aria-hidden="true"></span>{site.name}</a>
      <p>{site.positioning}</p>
    </div>
    <div class="footer-meta">
      {(email || github || linkedIn) && <ul class="contact-links">
        {email && <li><a href={`mailto:${email}`}>Email</a></li>}
        {github && <li><a href={github}>GitHub</a></li>}
        {linkedIn && <li><a href={linkedIn}>LinkedIn</a></li>}
      </ul>}
      <small>© {new Date().getFullYear()} {site.author === 'YOUR_NAME' ? site.englishName : site.author}</small>
    </div>
  </Container>
</footer>
