---
import Container from './Container.astro';
import { site } from '../config/site';
const { email, github, linkedIn } = site.contact;
---
<footer class="site-footer">
  <Container class="footer-inner">
    <p class="footer-invite">{site.footerInvite}</p>
    <ul class="footer-meta">
      {email && <li><span>邮件</span><a href={`mailto:${email}`}>{email}</a></li>}
      {github && <li><span>GitHub</span><a href={github}>{github.replace('https://github.com/', '')}</a></li>}
      {linkedIn && <li><span>LinkedIn</span><a href={linkedIn}>LinkedIn</a></li>}
      <li><span>RSS</span><a href="/rss.xml">/rss.xml</a></li>
      <li class="qr-item"><span>微信公众号</span>
        <button class="qr-trigger" type="button" aria-expanded="false" aria-controls="wechat-qr" data-qr-trigger>超越产品思维</button>
        <div id="wechat-qr" class="qr-pop" role="dialog" aria-label="微信公众号二维码" hidden data-qr-pop>
          <img src="/images/wechat-qr.jpg" width="430" height="430" alt="微信公众号「超越产品思维」二维码" loading="lazy" decoding="async" />
          <p>微信扫一扫，关注「超越产品思维」</p>
        </div>
      </li>
    </ul>
  </Container>
</footer>

<script>
  const trigger = document.querySelector<HTMLButtonElement>('[data-qr-trigger]');
  const pop = document.querySelector<HTMLElement>('[data-qr-pop]');
  if (trigger && pop) {
    const set = (open: boolean) => { pop.hidden = !open; trigger.setAttribute('aria-expanded', String(open)); };
    trigger.addEventListener('click', (event) => { event.stopPropagation(); set(pop.hidden !== false); });
    document.addEventListener('click', (event) => { if (!pop.hidden && !pop.contains(event.target as Node)) set(false); });
    document.addEventListener('keydown', (event) => { if (event.key === 'Escape' && !pop.hidden) { set(false); trigger.focus(); } });
  }
</script>

<style>
  .qr-item { position: relative; }
  .qr-trigger { cursor: pointer; padding: 0; border: 0; background: none; color: var(--ink); font: inherit; text-decoration: underline; text-decoration-color: var(--line); text-underline-offset: .3em; }
  .qr-trigger:hover, .qr-trigger[aria-expanded="true"] { color: var(--red); text-decoration-color: currentColor; }
  .qr-pop { position: absolute; z-index: 30; right: 0; bottom: calc(100% + 10px); width: 200px; padding: 12px; background: #fff; border: 1px solid var(--line); box-shadow: 0 20px 50px #16140f33; text-align: center; }
  .qr-pop[hidden] { display: none; }
  .qr-pop img { display: block; width: 100%; height: auto; }
  .qr-pop p { margin-top: 8px; color: var(--mute); font: 500 11px/1.5 var(--font-label); }
  .qr-pop::after { content: ''; position: absolute; right: 24px; top: 100%; border: 7px solid transparent; border-top-color: #fff; }
</style>
