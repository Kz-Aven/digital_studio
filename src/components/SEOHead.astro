---
import { site } from '../config/site';
interface Props {
  title?: string;
  description: string;
  image?: { src: string; alt: string };
  noindex?: boolean;
  type?: 'website' | 'article';
  structuredData?: Record<string, unknown>;
}

const { title, description, image = { src: '/images/studio-og.png', alt: site.englishName }, noindex = false, type = 'website', structuredData } = Astro.props;
const fullTitle = title ? `${title} · ${site.name}` : site.name;
const canonical = Astro.site && !noindex ? new URL(Astro.url.pathname, Astro.site).href : undefined;
---
<title>{fullTitle}</title>
<meta name="description" content={description} />
{canonical && <link rel="canonical" href={canonical} />}
{noindex && <meta name="robots" content="noindex" />}
<meta property="og:site_name" content={site.name} />
<meta property="og:type" content={type} />
<meta property="og:locale" content="zh_CN" />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
{canonical && <>
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={new URL(image.src, canonical).href} />
  <meta property="og:image:alt" content={image.alt} />
</>}
{structuredData && <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData).replace(/</g, '\\u003c')} />}
