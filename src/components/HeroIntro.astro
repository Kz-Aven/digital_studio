---
import { site } from '../config/site';
const [opening, statement, product] = site.heroTitle;
---
<section class="hero" aria-labelledby="intro-title">
  <div>
    <p class="eyebrow hero-label" lang="en">{site.heroLabel}</p>
    <h1 id="intro-title">
      <span>{opening}</span>
      <span>{statement} <span class="hero-product">{product}</span></span>
    </h1>
    <p class="hero-description">{site.heroDescription}</p>
    <div class="flex flex-wrap items-center gap-x-6 gap-y-2">
      <a class="button" href="/work/">查看项目</a>
      <a class="text-link" href="/about/">了解我</a>
    </div>
  </div>
  <aside class="hero-focus" aria-label="关注领域">
    <p class="eyebrow">Focus</p>
    <ul lang="en">
      {site.focus.map((item) => <li>{item}</li>)}
    </ul>
  </aside>
</section>
