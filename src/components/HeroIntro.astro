---
import { site } from '../config/site';
const [opening, statement, product] = site.heroTitle;
---
<section class="home-intro" aria-labelledby="intro-title">
  <p class="eyebrow" lang="en">{site.heroLabel}</p>
  <h1 id="intro-title">{opening}{statement} {product}</h1>
  <p class="hero-description">{site.heroDescription}</p>
</section>
