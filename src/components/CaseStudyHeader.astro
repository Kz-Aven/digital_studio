---
import type { CollectionEntry } from 'astro:content';

interface Props {
  data: CollectionEntry<'work'>['data'];
}
const { data } = Astro.props;
const metadata = [
  { label: '我的角色', value: data.role },
  { label: '项目时间', value: data.period },
  { label: '状态', value: data.status },
].filter(({ value }) => value);
---
<header class="case-header">
  <p class="eyebrow case-label" lang="en">Case Study / {data.category.split(' / ')[0]}</p>
  <h1 data-pagefind-meta="title">{data.title}</h1>
  <p class="page-description">{data.subtitle ?? data.description}</p>
  {metadata.length > 0 && <dl class="case-meta">
    {metadata.map(({ label, value }) => <div><dt>{label}</dt><dd>{value}</dd></div>)}
  </dl>}
</header>
