---
import type { MarkdownHeading } from 'astro';

interface Props {
  headings: MarkdownHeading[];
  label?: string;
}
const { headings, label = '案例目录' } = Astro.props;
const sections = headings.filter(({ depth }) => depth === 2 || depth === 3);
---
{sections.length > 0 && (
  <nav class="case-toc" aria-label={label} data-pagefind-ignore>
    <details>
      <summary>{label}</summary>
      <ol>
        {sections.map(({ slug, text, depth }) => (
          <li class:list={{ 'toc-subsection': depth === 3 }}><a href={`#${slug}`}>{text.replace(/^\d+\s*\/\s*/, '')}</a></li>
        ))}
      </ol>
    </details>
  </nav>
)}

<script>
  const toc = document.querySelector<HTMLDetailsElement>('.case-toc details');
  if (toc) {
    const wide = matchMedia('(min-width: 80rem)');
    const summary = toc.querySelector('summary')!;
    toc.open = wide.matches;
    wide.addEventListener('change', ({ matches }) => { toc.open = matches; });
    toc.addEventListener('click', (event) => {
      if (!wide.matches && event.target instanceof HTMLAnchorElement) toc.open = false;
    });
    window.addEventListener('click', (event) => {
      if (!wide.matches && toc.open && event.target instanceof Node && !toc.contains(event.target)) toc.open = false;
    });
    window.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape' || !toc.open || !toc.contains(document.activeElement)) return;
      toc.open = false;
      summary.focus();
    });

    const links = Array.from(toc.querySelectorAll<HTMLAnchorElement>('a'));
    const sections = links.map((link) => document.getElementById(decodeURIComponent(link.hash.slice(1))));
    let active = -1;
    let frame = 0;
    const update = () => {
      const atEnd = window.scrollY + window.innerHeight >= document.documentElement.scrollHeight - 2;
      const next = atEnd ? links.length - 1 : sections.findLastIndex((section) =>
        section && section.getBoundingClientRect().top <= parseFloat(getComputedStyle(section).scrollMarginTop) + 1,
      );
      if (next !== active) {
        links[active]?.removeAttribute('aria-current');
        links[next]?.setAttribute('aria-current', 'location');
        active = next;
      }
      frame = 0;
    };
    update();
    window.addEventListener('scroll', () => {
      if (!frame) frame = window.requestAnimationFrame(update);
    }, { passive: true });
  }
</script>
