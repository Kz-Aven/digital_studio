---
import { formatDate } from '../config/content';
import { writingSeries, writingTopics, writingTypes, type WritingItem } from '../config/writing';

interface Props {
  entry: WritingItem;
  level?: 'h2' | 'h3';
  compact?: boolean;
}
const { entry, level: Heading = 'h2', compact = false } = Astro.props;
const href = entry.localSlug ? `/writing/${entry.localSlug}/` : entry.sourceUrl;
---
<article
  class:list={['writing-row', { 'writing-row--compact': compact, 'writing-row--illustrated': entry.cover }]}
  id={`wx-${entry.id}`}
  tabindex={compact ? undefined : '-1'}
  data-writing-row
  data-topic={entry.topic}
  data-type={entry.type}
  data-featured={entry.featured ? '' : undefined}
  data-editorial-order={entry.editorialOrder}
  data-search={[entry.title, ...entry.tags].join(' ')}
>
  <div class="writing-row-copy">
    <Heading>
      <a class="writing-original" href={href} target={entry.localSlug ? undefined : '_blank'} rel={entry.localSlug ? undefined : 'noopener noreferrer'}>
        {entry.title}
        {!entry.localSlug && <><span class="writing-link-icon" aria-hidden="true">↗</span><span class="sr-only">（公众号原文，在新标签页打开）</span></>}
      </a>
    </Heading>
    <ul class="writing-meta" aria-label="文章信息">
      <li class="writing-source">
        {entry.localSlug
          ? <a href={entry.sourceUrl} target="_blank" rel="noopener noreferrer">公众号原文 <span aria-hidden="true">↗</span></a>
          : '公众号原文'}
      </li>
      <li><a href={`/writing/topics/${entry.topic}/`}>{writingTopics[entry.topic].label}</a></li>
      <li>{writingTypes[entry.type]}</li>
      {entry.series && !compact && <li><a href={`/writing/series/${entry.series}/`}>{writingSeries[entry.series].label}</a></li>}
      {entry.publishedAt && <li><time datetime={entry.publishedAt}>{formatDate(new Date(entry.publishedAt))}</time></li>}
    </ul>
    <slot />
  </div>
  {entry.cover && (
    <img
      class="writing-cover"
      src={entry.cover.src}
      alt={entry.cover.alt}
      width="384"
      height="216"
      loading="lazy"
      decoding="async"
    />
  )}
</article>
