---
interface Props {
  id: string;
  title: string;
  label?: string;
  link?: { href: string; text: string };
  note?: string;
}
const { id, title, link, note } = Astro.props;
---
<div class="section-heading">
  <h2 id={id}>{title}</h2>
  {link ? <a class="text-link" href={link.href}>{link.text}</a> : note && <span class="mono">{note}</span>}
</div>
