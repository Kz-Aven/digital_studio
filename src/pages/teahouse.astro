---
import SEOHead from '../components/SEOHead.astro';
import { site } from '../config/site';
import '../styles/global.css';
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <SEOHead title="禅意茶舍" description={site.teahouse.description} noindex />
  </head>
  <body class="exhibit">
    <header>
      <h1>禅意茶舍</h1>
      <a href="/">返回首页</a>
    </header>

    <main class="scene" aria-label="禅意茶舍三维场景">
      <img class="poster" src="/teahouse-assets/poster.webp" alt="禅意茶舍场景预览" fetchpriority="high" />
    </main>

    <footer>
      <output>正在加载茶舍…</output>
    </footer>
  </body>
</html>

<script>
  const scene = document.querySelector<HTMLElement>('.scene')!;
  const status = document.querySelector<HTMLOutputElement>('output')!;
  import('../scripts/teahouse.js')
    .then(({ showTeahouse }) => showTeahouse(scene))
    .then(() => { status.textContent = '拖动旋转 · 右键拖动或双指滑动平移'; })
    .catch(error => {
      console.error(error);
      status.textContent = '三维场景加载失败，当前显示茶舍预览图';
    });
</script>

<style>
  .exhibit {
    display: grid;
    grid-template-rows: auto minmax(0, 1fr) auto;
    height: 100dvh;
    background: #191612;
    color: #f4eadc;
    font-family: -apple-system, "PingFang SC", sans-serif;
  }

  header, footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 14px clamp(14px, 3vw, 42px);
  }

  header { border-bottom: 1px solid #41372d; }
  h1 { margin: 0; font-size: 18px; font-weight: 550; letter-spacing: .12em; }
  a { font-size: 13px; text-decoration: underline; text-underline-offset: .25em; }
  footer { border-top: 1px solid #41372d; color: #ccbca9; font-size: 12px; }

  .scene { position: relative; overflow: hidden; background: #fff; }
  .poster, .scene :global(canvas) { position: absolute; inset: 0; width: 100%; height: 100%; }
  .poster { object-fit: contain; }
  .scene :global(canvas) { visibility: hidden; touch-action: none; cursor: grab; }
  .scene[data-ready] .poster { visibility: hidden; }
  .scene[data-ready] :global(canvas) { visibility: visible; }
  .scene :global(canvas:active) { cursor: grabbing; }
</style>
