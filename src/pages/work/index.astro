---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/Container.astro';
import ProjectRow from '../../components/ProjectRow.astro';
import { site } from '../../config/site';
import { publicWork } from '../../config/content';

const work = await publicWork();
---
<BaseLayout title="作品" description={site.workDescription}>
  <Container class="page-content">
    <header class="page-intro">
      
      <h1>作品</h1>
      <p class="page-description">{site.workDescription}</p>
    </header>
    {work.length > 0
      ? work.map((entry, index) => <ProjectRow entry={entry} eager={index === 0} />)
      : <p>暂无公开的项目案例。</p>}
  </Container>
</BaseLayout>
