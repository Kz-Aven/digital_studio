---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/Container.astro';
import { site } from '../config/site';

const { email, github, linkedIn, resume } = site.contact;
const skills = [
  '企业 AI Agent 产品设计',
  '复杂 B2B 系统',
  '业务流程与权限治理',
  'AI 产品评测与落地',
];
const methods = [
  { title: '业务问题', text: '从角色、任务和现有流程入手，厘清产品需要解决的具体问题。' },
  { title: '系统抽象', text: '将业务目标拆成可接入的数据、知识、工具和权限。' },
  { title: '关键取舍', text: '根据任务风险决定哪里需要 Agent 判断，哪里需要确定性流程。' },
  { title: '交付验证', text: '用真实任务检查产品表现，并据此调整能力与权限。' },
];
---
<BaseLayout title="About / 关于" description={site.about}>
  <Container class="page-content">
    <header class="page-intro">
      
      <h1>{site.author === 'YOUR_NAME' ? '关于我' : site.author}</h1>
      <p class="about-positioning">{site.positioning}</p>
      <p class="page-description">{site.about}</p>
    </header>
    <section class="about-section" aria-labelledby="expertise">
      <h2 id="expertise">能力方向</h2>
      <ul class="about-list">
        {skills.map((skill) => <li>{skill}</li>)}
      </ul>
    </section>
    <section class="about-section" aria-labelledby="process">
      <h2 id="process">工作方式</h2>
      <ol class="about-list">
        {methods.map(({ title, text }) => <li><strong>{title}</strong><p>{text}</p></li>)}
      </ol>
    </section>
    {site.experience.length > 0 && <section class="about-section" aria-labelledby="experience">
      <h2 id="experience">经历</h2>
      <ul class="about-list">
        {site.experience.map(({ period, organization, role }) => <li><strong>{organization}</strong><p>{period} · {role}</p></li>)}
      </ul>
    </section>}
    <section class="about-section" aria-labelledby="contact">
      <h2 id="contact">联系方式</h2>
      <div class="about-contact">
      <ul class="contact-links">
        {email && <li><a href={`mailto:${email}`}>{email}</a></li>}
        {github && <li><a href={github}>GitHub</a></li>}
        {linkedIn && <li><a href={linkedIn}>LinkedIn</a></li>}
        {resume && <li><a href={resume}>简历 PDF</a></li>}
      </ul>
      <figure class="about-wechat">
        <img src="/images/wechat-qr.jpg" width="430" height="430" alt="微信公众号「超越产品思维」二维码" loading="lazy" decoding="async" />
        <figcaption><span class="mono">微信公众号</span><strong>超越产品思维</strong><span>微信扫一扫关注，新文章会先发在这里。手机上可长按图片识别。</span></figcaption>
      </figure>
      </div>
    </section>
  </Container>
</BaseLayout>

<style>
  .about-contact { min-width: 0; }
  .about-wechat { display: flex; align-items: center; gap: 24px; margin-top: 1.5rem; padding-top: 1.5rem; border-top: 1px solid var(--line); }
  .about-wechat img { flex: none; width: 160px; height: 160px; background: #fff; padding: 8px; border: 1px solid var(--line); }
  .about-wechat figcaption { display: grid; gap: 4px; min-width: 0; }
  .about-wechat strong { font: 700 1.4rem/1.3 var(--font-serif); }
  .about-wechat figcaption > span:last-child { color: var(--mute); font-size: .875rem; }
  @media (max-width: 480px) { .about-wechat { flex-direction: column; align-items: flex-start; } }
</style>
