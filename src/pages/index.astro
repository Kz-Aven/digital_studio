---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/Container.astro';
import HeroIntro from '../components/HeroIntro.astro';
import SectionHeading from '../components/SectionHeading.astro';
import IndexRow from '../components/IndexRow.astro';
import StudioCard from '../components/StudioCard.astro';
import { site } from '../config/site';
import { publicStudio, publicWork, studioStatuses } from '../config/content';
import { featuredWriting, writing, writingTopics } from '../config/writing';

const [work, studio] = await Promise.all([publicWork(), publicStudio()]);
const rows = [
  ...work.map((e) => ({
    href: `/work/${e.id}/`, title: e.data.title.split('：')[0], summary: e.data.subtitle ?? e.data.description,
    role: e.data.role?.split('、')[0], year: e.data.period?.split(' ')[0], status: e.data.status, image: e.data.cover?.small ?? e.data.cover?.src,
  })),
  ...studio.map((e) => ({
    href: `/studio/${e.id}/`, title: e.data.title, summary: e.data.description,
    role: `开源 · ${e.data.stack[0] ?? ''}`, year: e.data.publishedAt.toISOString().slice(0, 7).replace('-', '.'),
    status: e.data.status === 'released' ? undefined : studioStatuses[e.data.status], image: e.data.cover?.small ?? e.data.cover?.src,
  })),
];
const years = rows.map((r) => r.year?.slice(0, 4)).filter(Boolean).sort();
---
<BaseLayout description={site.heroDescription}>
  <Container>
    <HeroIntro />
    <section aria-labelledby="work-index">
      <SectionHeading id="work-index" title="项目索引" note={`${String(rows.length).padStart(2, '0')} 项 · ${years[0]}—${years.at(-1)}`} />
      <ol class="index-list">
        {rows.map((row, i) => <IndexRow no={i + 1} total={rows.length} {...row} />)}
      </ol>
    </section>
  </Container>

  <Container>
    <div class="feature-pair">
      <section class="tea-band" aria-labelledby="tea-title">
        <img src="/teahouse-assets/poster.webp" alt="" loading="lazy" decoding="async" />
        <div class="tea-band-inner">
          <div class="tea-copy">
            <p class="mono">实验 · 3D 高斯泼溅场景</p>
            <h2 id="tea-title">一间茶舍</h2>
            <p>{site.teahouse.description}</p>
            <a class="tea-enter" href="/teahouse/">进入茶舍 <span class="mono">{site.teahouse.size}</span></a>
          </div>
        </div>
      </section>
      <section class="tea-band research-band" aria-labelledby="research-title">
        <img src="/images/research-hero.webp" alt="" loading="lazy" decoding="async" />
        <div class="tea-band-inner">
          <div class="tea-copy">
            <p class="mono">行研 · 12 个行业 · 706 个案例</p>
            <h2 id="research-title">行业微缩图</h2>
            <p>跟着一件小事走一遍，看懂一个陌生行业里谁拿着什么、交给了谁。</p>
            <a class="tea-enter" href="/research/">进入行研 <span class="mono">12 个行业</span></a>
          </div>
        </div>
      </section>
    </div>
  </Container>

  <Container>
    <div class="home-split">
      {studio.length > 0 && <section aria-labelledby="studio-tools">
        <SectionHeading id="studio-tools" title="开源项目" link={{ href: '/studio/', text: '全部开源项目' }} />
        {studio.slice(0, 3).map((entry) => <StudioCard entry={entry} />)}
      </section>}
      {featuredWriting.length > 0 && <section aria-labelledby="featured-writing">
        <SectionHeading id="featured-writing" title="文章" note={`${writing.length} 篇`} />
        <ul class="feature-list">
          {featuredWriting.slice(0, 5).map((e) => (
            <li>
              <a href={e.localSlug ? `/writing/${e.localSlug}/` : e.sourceUrl!} target={e.localSlug ? undefined : '_blank'} rel={e.localSlug ? undefined : 'noopener noreferrer'}>{e.title}</a>
              <div class="mono"><span>{writingTopics[e.topic].short}</span><span>{e.localSlug ? '站内' : '公众号 ↗'}</span></div>
            </li>
          ))}
        </ul>
        <a class="text-link" href="/writing/">全部 {writing.length} 篇 · 按领域浏览 →</a>
      </section>}
    </div>
  </Container>
  <div class="peek" data-peek-layer aria-hidden="true"></div>
</BaseLayout>

<script>
  const peek = document.querySelector<HTMLElement>('[data-peek-layer]')!;
  if (matchMedia('(hover: hover)').matches) {
    for (const row of document.querySelectorAll<HTMLElement>('[data-peek]')) {
      const src = row.dataset.peek;
      if (!src) continue;
      new Image().src = src;
      row.addEventListener('mouseenter', () => { peek.style.backgroundImage = `url("${src}")`; peek.toggleAttribute('data-on', true); });
      row.addEventListener('mouseleave', () => peek.removeAttribute('data-on'));
      row.addEventListener('mousemove', (e) => {
        peek.style.left = `${Math.min(e.clientX + 200, innerWidth - 180)}px`;
        peek.style.top = `${Math.max(120, Math.min(e.clientY, innerHeight - 120))}px`;
      });
    }
  }
</script>
