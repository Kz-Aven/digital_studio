---
import { getEntry, render } from 'astro:content';
import type { InferGetStaticPropsType } from 'astro';
import ReadingPage from '../../layouts/ReadingPage.astro';
import Prose from '../../components/Prose.astro';
import { formatDate } from '../../config/content';
import { writing, writingTopics, writingTypes } from '../../config/writing';

export async function getStaticPaths() {
  return Promise.all(writing.filter((entry) => entry.localSlug).map(async (entry) => {
    const slug = entry.localSlug!;
    const markdown = await getEntry('writing', slug);
    if (!markdown) throw new Error(`Missing Writing article: ${slug}`);
    return { params: { slug }, props: { entry, markdown } };
  }));
}
type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { entry, markdown } = Astro.props;
const { Content, headings } = await render(markdown);
const topic = writingTopics[entry.topic];
---
<ReadingPage
  title={entry.title}
  description={entry.excerpt ?? entry.title}
  image={entry.cover}
  headings={headings}
  back={{ label: '研究与实践', href: '/writing/' }}
>
  <header class="case-header" slot="header">
    <p class="eyebrow case-label">Writing / {writingTypes[entry.type]}</p>
    <h1 data-pagefind-meta="title">{entry.title}</h1>
    <div class="article-actions" data-pagefind-ignore>
      <a class="text-link" href={`/writing/topics/${entry.topic}/`}>{topic.label}</a>
      {entry.publishedAt && <time datetime={entry.publishedAt}>{formatDate(new Date(entry.publishedAt))}</time>}
      <a class="text-link" href={entry.sourceUrl} target="_blank" rel="noopener noreferrer">公众号原文 ↗</a>
    </div>
  </header>
  <Prose><Content /></Prose>
</ReadingPage>
