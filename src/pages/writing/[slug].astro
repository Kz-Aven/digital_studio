---
import { render } from 'astro:content';
import type { InferGetStaticPropsType } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/Container.astro';
import CaseStudyTOC from '../../components/CaseStudyTOC.astro';
import Figure from '../../components/Figure.astro';
import Prose from '../../components/Prose.astro';
import CopyLink from '../../components/CopyLink.astro';
import TagList from '../../components/TagList.astro';
import { formatDate, publicWriting, readingMinutes } from '../../config/content';

export async function getStaticPaths() {
  const entries = await publicWriting();
  return entries.map((entry, index) => ({
    params: { slug: entry.id },
    props: { entry, newer: entries[index - 1], older: entries[index + 1] },
  }));
}

type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { entry, newer, older } = Astro.props;
const { data } = entry;
const { Content, headings } = await render(entry);
---
<BaseLayout
  title={data.title}
  description={data.seoDescription ?? data.description}
  image={data.cover}
  type="article"
  searchable
  structuredData={{
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: data.title,
    description: data.description,
    url: new URL(Astro.url.pathname, Astro.site).href,
    datePublished: data.publishedAt.toISOString(),
    dateModified: data.updatedAt?.toISOString(),
    image: data.cover && new URL(data.cover.src, Astro.site).href,
    inLanguage: 'zh-CN',
  }}
>
  <Container class="case-content writing-detail">
    <article>
      <header class="case-header">
        <a class="text-link" data-pagefind-ignore href="/writing/">← 返回 Writing</a>
        <p class="eyebrow case-label"><span lang="en">Writing</span> / {data.category}</p>
        <h1 data-pagefind-meta="title">{data.title}</h1>
        <p class="page-description">{data.description}</p>
        <p class="article-meta article-byline">
          站内发布于 <time datetime={data.publishedAt.toISOString()}>{formatDate(data.publishedAt)}</time>
          <span aria-hidden="true">·</span> 约 {readingMinutes(entry.body)} 分钟
        </p>
        <TagList tags={data.tags} />
        <div class="article-actions" data-pagefind-ignore>
          <CopyLink />
          {data.externalUrl && <a class="text-link" href={data.externalUrl}>阅读公众号原文（站外）</a>}
          <a class="text-link" href="/rss.xml">订阅 RSS</a>
        </div>
      </header>
      {data.cover && <Figure cover={data.cover} sizes="(max-width: 1279px) 100vw, 1200px" eager />}
      <div class="case-grid">
        <CaseStudyTOC headings={headings} label="文章目录" />
        <div class="case-reading">
          <Prose><Content /></Prose>
          {(newer || older) && <nav class="case-end article-neighbors" data-pagefind-ignore aria-label="相邻文章">
            {newer && <a href={`/writing/${newer.id}/`}><span class="eyebrow">上一篇</span>{newer.data.title}</a>}
            {older && <a href={`/writing/${older.id}/`}><span class="eyebrow">下一篇</span>{older.data.title}</a>}
          </nav>}
        </div>
      </div>
    </article>
  </Container>
</BaseLayout>
