---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/Container.astro';
import ArticleRow from '../../components/ArticleRow.astro';
import WritingSeriesLinks from '../../components/WritingSeriesLinks.astro';
import { site } from '../../config/site';
import { seriesIds, topicIds, typeIds, writing, writingTopics, writingTypes } from '../../config/writing';
---
<BaseLayout title="Writing / 研究与实践" description={site.writingDescription}>
  <Container class="page-content writing-shell">
    <header class="page-intro writing-intro">
      <div>
        <p class="eyebrow" lang="en">Writing</p>
        <h1>研究与实践</h1>
        <p class="page-description">{site.writingDescription}</p>
      </div>
      <p class="writing-total"><strong>{writing.length}</strong> 篇文章</p>
    </header>

    <nav class="writing-topics" aria-label="研究领域">
      <a href="/writing/" data-topic-filter="" aria-current="true">全部 <span>{writing.length}</span></a>
      {topicIds.map((id) => (
        <a href={`/writing/topics/${id}/`} data-topic-filter={id}>
          {writingTopics[id].short} <span>{writing.filter(({ topic }) => topic === id).length}</span>
        </a>
      ))}
    </nav>

    <form id="writing-filters" class="writing-filters" action="/writing/" role="search" aria-label="筛选文章" hidden>
      <div class="writing-query">
        <label for="writing-q">标题或标签</label>
        <div>
          <input id="writing-q" name="q" type="search" placeholder="例如，排产、评测" />
          <button class="button" type="submit">搜索</button>
        </div>
      </div>
      <div>
        <label for="writing-type">文章类型</label>
        <select id="writing-type" name="type">
          <option value="">全部类型</option>
          {typeIds.map((id) => <option value={id}>{writingTypes[id]}</option>)}
        </select>
      </div>
      <div>
        <label for="writing-order">排序</label>
        <select id="writing-order" name="order">
          <option value="">默认顺序</option>
          <option value="featured">编辑精选</option>
        </select>
      </div>
    </form>

    <WritingSeriesLinks ids={seriesIds} label="专题" />

    <div class="writing-toolbar">
      <p id="writing-result-count" role="status">{writing.length} 篇文章</p>
      <div>
        <a id="writing-topic-details" class="text-link" hidden>领域介绍</a>
        <a id="writing-clear" class="text-link" href="/writing/" hidden>清空筛选</a>
      </div>
    </div>
    <div id="writing-articles" aria-label="文章列表">
      {writing.map((entry) => <ArticleRow entry={entry} />)}
    </div>
    <p class="writing-empty" id="writing-empty" hidden>没有匹配的文章。可以更换关键词或清空筛选。</p>
  </Container>
</BaseLayout>

<script>
  import { writingMatchesQuery } from '../../config/writing-query';

  const form = document.querySelector<HTMLFormElement>('#writing-filters')!;
  const search = document.querySelector<HTMLInputElement>('#writing-q')!;
  const type = document.querySelector<HTMLSelectElement>('#writing-type')!;
  const order = document.querySelector<HTMLSelectElement>('#writing-order')!;
  const topics = document.querySelector<HTMLElement>('.writing-topics')!;
  const topicLinks = [...topics.querySelectorAll<HTMLAnchorElement>('[data-topic-filter]')];
  const list = document.querySelector('#writing-articles')!;
  const rows = [...list.querySelectorAll<HTMLElement>('[data-writing-row]')];
  const featured = rows.toSorted((a, b) => Number(b.hasAttribute('data-featured')) - Number(a.hasAttribute('data-featured'))
    || (a.hasAttribute('data-featured') && b.hasAttribute('data-featured')
      ? Number(a.dataset.editorialOrder) - Number(b.dataset.editorialOrder) : 0));
  const result = document.querySelector('#writing-result-count')!;
  const empty = document.querySelector<HTMLElement>('#writing-empty')!;
  const clear = document.querySelector<HTMLAnchorElement>('#writing-clear')!;
  const details = document.querySelector<HTMLAnchorElement>('#writing-topic-details')!;
  let selectedTopic = '';
  let sorting = '';

  function apply() {
    const params = new URLSearchParams(location.search);
    const active = topicLinks.find((link) => link.dataset.topicFilter === (params.get('topic') ?? '')) ?? topicLinks[0];
    selectedTopic = active.dataset.topicFilter!;
    search.value = params.get('q') ?? '';
    type.value = params.get('type') ?? '';
    if (type.selectedIndex < 0) type.selectedIndex = 0;
    order.value = params.get('order') === 'featured' ? 'featured' : '';
    for (const link of topicLinks) {
      if (link === active) link.setAttribute('aria-current', 'true');
      else link.removeAttribute('aria-current');
    }
    const rail = topics.getBoundingClientRect();
    const item = active.getBoundingClientRect();
    topics.scrollLeft += Math.min(0, item.left - rail.left) + Math.max(0, item.right - rail.right);
    details.hidden = !selectedTopic;
    details.href = active.href;
    clear.hidden = !(selectedTopic || type.value || order.value || search.value.trim());

    if (order.value !== sorting) {
      list.append(...(order.value === 'featured' ? featured : rows));
      sorting = order.value;
    }

    let count = 0;
    for (const row of rows) {
      row.hidden = (selectedTopic !== '' && row.dataset.topic !== selectedTopic)
        || (type.value !== '' && row.dataset.type !== type.value)
        || !writingMatchesQuery(row.dataset.search!, search.value);
      if (!row.hidden) count++;
    }
    empty.hidden = count !== 0;
    result.textContent = count === rows.length ? `${count} 篇文章` : `显示 ${count} / ${rows.length} 篇文章`;
  }

  function navigate(params: URLSearchParams) {
    const query = params.toString();
    const next = query ? `?${query}` : '/writing/';
    if (query ? next !== location.search : location.search !== '') history.pushState(null, '', next);
    apply();
  }

  function update() {
    const params = new URLSearchParams();
    if (selectedTopic) params.set('topic', selectedTopic);
    if (type.value) params.set('type', type.value);
    if (search.value.trim()) params.set('q', search.value.trim());
    if (order.value) params.set('order', order.value);
    navigate(params);
  }

  for (const link of topicLinks) link.addEventListener('click', (event) => {
    if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
    event.preventDefault();
    selectedTopic = link.dataset.topicFilter!;
    update();
  });
  form.addEventListener('submit', (event) => { event.preventDefault(); update(); });
  type.addEventListener('change', update);
  order.addEventListener('change', update);
  clear.addEventListener('click', (event) => {
    if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
    event.preventDefault();
    navigate(new URLSearchParams());
    search.focus();
  });
  window.addEventListener('popstate', apply);
  apply();
  form.hidden = false;
</script>
