---
import { render } from 'astro:content';
import ReadingPage from '../../layouts/ReadingPage.astro';
import type { InferGetStaticPropsType } from 'astro';
import Prose from '../../components/Prose.astro';
import TagList from '../../components/TagList.astro';
import RelatedWriting from '../../components/RelatedWriting.astro';
import { publicStudio, studioStatuses } from '../../config/content';

export async function getStaticPaths() {
  return (await publicStudio()).map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { entry } = Astro.props;
const { data } = entry;
const { Content, headings } = await render(entry);
---
<ReadingPage
  title={data.title}
  description={data.seoDescription ?? data.description}
  image={data.cover}
  headings={headings}
  back={{ label: '个人创造', href: '/studio/' }}
>
  <header class="case-header" slot="header">
    <p class="eyebrow case-label"><span lang="en">Studio</span> / {studioStatuses[data.status]}</p>
    <h1 data-pagefind-meta="title">{data.title}</h1>
    <p class="page-description">{data.description}</p>
    <div class="article-actions" data-pagefind-ignore>
      {data.githubUrl && <a class="text-link" href={data.githubUrl}>GitHub README</a>}
      {data.demoUrl && <a class="text-link" href={data.demoUrl}>查看 Demo</a>}
    </div>
    <TagList tags={data.tags} />
  </header>
  {data.stack.length > 0 && <p class="article-meta stack-line">技术栈 · {data.stack.join(' / ')}</p>}
  <Prose><Content /></Prose>
  <RelatedWriting id={entry.id} />
</ReadingPage>
