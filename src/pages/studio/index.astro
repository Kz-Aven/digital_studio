---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/Container.astro';
import StudioCard from '../../components/StudioCard.astro';
import { publicStudio } from '../../config/content';
import { site } from '../../config/site';

const entries = await publicStudio();
---
<BaseLayout title="工具" description={site.studioDescription}>
  <Container class="page-content">
    <header class="page-intro">
      
      <h1>工具</h1>
      <p class="page-description">{site.studioDescription}</p>
    </header>
    {entries.length > 0 ? <div>
      {entries.map((entry) => <StudioCard entry={entry} />)}
    </div> : <p class="empty-content">暂无公开作品。</p>}
  </Container>
</BaseLayout>
