---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/Container.astro';
import StudioCard from '../../components/StudioCard.astro';
import { publicStudio, studioCategories } from '../../config/content';
import { site } from '../../config/site';

const entries = await publicStudio();
const groups = Object.entries(studioCategories).map(([key, label]) => ({ key, label, items: entries.filter((e) => e.data.category === key) })).filter((g) => g.items.length);
---
<BaseLayout title="开源" description={site.studioDescription}>
  <Container class="page-content">
    <header class="page-intro">
      
      <h1>开源</h1>
      <p class="page-description">{site.studioDescription}</p>
    </header>
    {entries.length > 0 ? <>
      <div class="research-chips studio-filter" role="group" aria-label="按用途筛选">
        <button type="button" data-f="all" aria-pressed="true">全部 <span class="mono">{entries.length}</span></button>
        {groups.map((g) => <button type="button" data-f={g.key} aria-pressed="false">{g.label} <span class="mono">{g.items.length}</span></button>)}
      </div>
      {groups.map((g) => <section class="studio-group" data-group={g.key} aria-labelledby={`g-${g.key}`}>
        <div class="section-heading"><h2 id={`g-${g.key}`}>{g.label}</h2><span class="mono">{g.items.length} 项</span></div>
        <div class="studio-list">{g.items.map((entry) => <StudioCard entry={entry} />)}</div>
      </section>)}
    </> : <p class="empty-content">暂无开源项目。</p>}
  </Container>
</BaseLayout>

<script>
  const btns = [...document.querySelectorAll<HTMLButtonElement>('.studio-filter [data-f]')];
  const groups = [...document.querySelectorAll<HTMLElement>('[data-group]')];
  btns.forEach((b) => b.addEventListener('click', () => {
    const f = b.dataset.f;
    btns.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
    groups.forEach((g) => { g.hidden = f !== 'all' && g.dataset.group !== f; });
  }));
</script>

<style>
  .studio-filter { margin-bottom: 8px; }
  .studio-filter .mono { margin-left: 4px; color: inherit; opacity: .6; }
  .studio-group { margin-top: clamp(40px, 6vw, 72px); }
  .studio-group[hidden] { display: none; }

  .studio-list :global(.studio-card) {
    grid-template-columns: minmax(0, 1fr);
  }

  .studio-list :global(.shot) {
    width: min(100%, 16rem);
    aspect-ratio: 3 / 2;
    background: transparent;
  }

  .studio-list :global(.shot img) {
    object-fit: contain;
    object-position: left center;
  }

  @media (min-width: 768px) {
    .studio-list :global(.studio-card) {
      grid-template-columns: minmax(0, 16rem) minmax(0, 1fr);
    }

    .studio-list :global(.shot) {
      position: relative;
      align-self: stretch;
      aspect-ratio: auto;
    }

    .studio-list :global(.shot img) {
      position: absolute;
      inset: 0;
    }
  }
</style>
