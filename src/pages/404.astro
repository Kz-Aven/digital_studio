---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/Container.astro';
import { pad, portfolio } from '../config/content';
import { featuredWriting } from '../config/writing';

const { items } = await portfolio();
const reads = featuredWriting.slice(0, 3);
---
<BaseLayout title="页面未找到" description="你要找的页面可能已经移动或删除。" noindex>
  <Container class="page-content nf">
    <section class="nf-hero">
      <p class="nf-code" aria-hidden="true">404</p>
      <div class="nf-copy">
        <p class="mono">页面未找到 · <span data-nf-path></span></p>
        <h1>这一页不在了，但项目都还在。</h1>
        <p class="nf-sub">链接可能已经改动。可以按 <kbd data-nf-kbd>⌘K</kbd> 搜索，或者从下面挑一个入口。</p>
        <div class="nf-actions">
          <a class="button" href="/">返回首页</a>
          <button class="button button--ghost" type="button" data-palette-open-alt>搜索全站</button>
        </div>
      </div>
    </section>

    <div class="nf-split">
      <section aria-labelledby="nf-work">
        <h2 id="nf-work" class="mono">项目索引</h2>
        <ol>
          {items.map((item, i) => <li><a href={item.href}><span class="mono">No.{pad(i + 1)}</span><span>{item.title.split('：')[0]}</span></a></li>)}
        </ol>
      </section>
      <section aria-labelledby="nf-read">
        <h2 id="nf-read" class="mono">先读这几篇</h2>
        <ol>
          {reads.map((e) => <li><a href={e.localSlug ? `/writing/${e.localSlug}/` : e.sourceUrl!}><span>{e.title}</span></a></li>)}
        </ol>
      </section>
    </div>
  </Container>
</BaseLayout>

<script>
  const path = document.querySelector('[data-nf-path]');
  if (path) path.textContent = decodeURIComponent(location.pathname);
  if (!/Mac|iPhone|iPad/.test(navigator.platform)) document.querySelector('[data-nf-kbd]')!.textContent = 'Ctrl K';
  document.querySelector('[data-palette-open-alt]')?.addEventListener('click', () => {
    document.querySelector<HTMLButtonElement>('[data-palette-open]')?.click();
  });
</script>

<style>
  .nf-hero { position: relative; display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: 24px; align-items: end; padding-block: clamp(48px, 8vw, 112px) clamp(48px, 6vw, 80px); }
  .nf-code { grid-column: 1 / 6; color: var(--bg); -webkit-text-stroke: 3px var(--ink); paint-order: stroke fill; font: 900 clamp(120px, 22vw, 340px)/.8 var(--font-serif); letter-spacing: -.02em; user-select: none; }
  .nf-copy { grid-column: 7 / 13; min-width: 0; }
  .nf-copy .mono span { color: var(--red); word-break: break-all; }
  .nf-copy h1 { margin-top: 14px; font: 900 clamp(32px, 4.4vw, 60px)/1.2 var(--font-serif); }
  .nf-sub { margin-top: 18px; color: var(--body-ink); }
  kbd { padding: 1px 6px; border: 1px solid var(--line); border-radius: 3px; background: var(--paper); font: 500 12px var(--font-label); }
  .nf-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 28px; }
  .nf-actions button { cursor: pointer; }

  .nf-split { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 40px; }
  .nf-split section { min-width: 0; padding-top: 14px; border-top: 2px solid var(--ink); }
  .nf-split h2 { margin-bottom: 4px; }
  .nf-split li { border-bottom: 1px solid var(--line); }
  .nf-split a { display: flex; gap: 16px; align-items: baseline; padding: 14px 0; font: 500 1.05rem/1.5 var(--font-serif); }
  .nf-split a .mono { flex: none; width: 52px; }
  .nf-split a:hover span:not(.mono) { color: var(--red); }

  @media (max-width: 900px) {
    .nf-code, .nf-copy { grid-column: 1 / -1; }
    .nf-copy { margin-top: 24px; }
    .nf-split { grid-template-columns: minmax(0, 1fr); }
  }
</style>
